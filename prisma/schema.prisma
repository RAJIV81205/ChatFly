// prisma/schema.prisma
// Define your database models

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/**
 * =========================
 * ENUMS
 * =========================
 */

enum ConversationType {
  PRIVATE
  GROUP
}

/**
 * =========================
 * USER
 * =========================
 */

model User {
  id       String @id @default(uuid())
  username String @unique
  fullName String
  email    String @unique
  phone    String @unique
  password String

  profilePicUrl String?
  profilePicPublicId String? 
  bio           String?

  emailVerified Boolean   @default(false)
  lastSeen      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /**
   * Relations
   */
  messages      Message[]
  readReceipts  ReadReceipt[]
  conversations ConversationMember[]
}

/**
 * =========================
 * EMAIL OTP
 * =========================
 */

model EmailOTP {
  id        String   @id @default(uuid())
  email     String
  otpHash   String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

/**
 * =========================
 * CONVERSATION
 * =========================
 */

model Conversation {
  id        String           @id @default(uuid())
  type      ConversationType
  name      String? // Only for GROUP
  createdAt DateTime         @default(now())

  members  ConversationMember[]
  messages Message[]
}

/**
 * =========================
 * CONVERSATION MEMBERS
 * =========================
 */

model ConversationMember {
  id             String  @id @default(uuid())
  conversationId String
  userId         String
  isAdmin        Boolean @default(false)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
}

/**
 * =========================
 * MESSAGE
 * =========================
 */

model Message {
  id             String @id @default(uuid())
  content        String // Encrypted content
  contentIv      String // Initialization vector for content encryption
  senderId       String
  conversationId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sender       User          @relation(fields: [senderId], references: [id], onDelete: Cascade)
  conversation Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  readReceipts ReadReceipt[]
  files        MessageFile[]
}

/**
 * =========================
 * READ RECEIPTS
 * =========================
 */

model ReadReceipt {
  id        String   @id @default(uuid())
  messageId String
  userId    String
  readAt    DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
}

/**
 * =========================
 * MESSAGE FILES
 * =========================
 */

model MessageFile {
  id        String @id @default(uuid())
  messageId String
  fileName  String // Encrypted filename
  fileNameIv String // IV for filename encryption
  fileUrl   String // Encrypted file URL
  fileUrlIv String // IV for file URL encryption
  fileSize  Int?
  mimeType  String?

  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
}
